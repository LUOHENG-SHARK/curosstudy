# ========== DeepSeek（默认）==========
# 控制台：https://platform.deepseek.com/api_keys
# 接口为 OpenAI 兼容：BASE_URL 默认已是 api.deepseek.com/v1
DEEPSEEK_API_KEY=

# 也可只用通用变量（优先级：LLM_API_KEY > DEEPSEEK_API_KEY > OPENAI_API_KEY）
# LLM_API_KEY=

# 可选覆盖（一般不必改）
# LLM_BASE_URL=https://api.deepseek.com/v1
# 对话模型：deepseek-chat | 深度推理：deepseek-reasoner（文案生成通常用 chat）
# LLM_MODEL=deepseek-chat
# LLM_TEMPERATURE=0.85

# ========== 改用 OpenAI 时 ==========
# LLM_BASE_URL=https://api.openai.com/v1
# LLM_MODEL=gpt-4o-mini
# OPENAI_API_KEY=
